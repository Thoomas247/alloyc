import std::io;
import std::process;

import tokenizer::tokenizer;
import parser::parser;
import parser::node_allocator;

fn main() {
    const entry_path = "tests/tokenizer_test.alloy";

    compile_module(&entry_path);
}

fn compile_module(path: &[u8]) {
    const src = if (read_file(&path) is ::Some |move src|) move src else {
        print_error_line("Failed to read file.");
        return;
    };

    const tokens = tokenize(&src);
    tokens.debug_print();

    const alloc_page_size: u64 = 10 * 1024 * 1024; // 10 MB
    var allocator = NodeAllocator::empty(alloc_page_size);

    const module = parse(&tokens, &var allocator);
}
