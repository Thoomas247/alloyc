import std::string;
import std::io as io;

import token_kind;
import token;
import source_cursor;
import tokenizer_state;

pub fn tokenize(src: &[u8]) -> Vector<Token> {
    var state = TokenizerState {
        .cursor = SourceCursor::create(&src),
        .tokens = Vector::empty()
    };

    while (state.has_next()) {

        if (skip_whitespace(&var state)
                || tokenize_comment(&var state)
                || tokenize_identifier(&var state)
                || tokenize_operator(&var state)
                || tokenize_number_literal(&var state)
                || tokenize_string_or_char_literal(&var state)) {
            continue;
        }

        const start_index = state.cursor.index;
        state.next();
        const token_view = &state.cursor.src[start_index..state.cursor.index];
        state.push(Token { .kind = ::error_invalid_character, .view = &token_view });
    }

    state.push(Token { .kind = ::end_of_file, .view = "" });

    return state.tokens;
}

pub fn debug_print(self tokens: &Vector<Token>) {
    for (tokens) |&t| {
        io::print_line(&t.to_string().view());
    }
}

fn is_whitespace(c: u8) -> bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

fn is_letter(c: u8) -> bool {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
}

fn is_decimal_digit(c: u8) -> bool {
    return c >= '0' && c <= '9';
}

fn is_hex_digit(c: u8) -> bool {
    return is_decimal_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

fn is_octal_digit(c: u8) -> bool {
    return c >= '0' && c <= '7';
}

fn is_binary_digit(c: u8) -> bool {
    return c == '0' || c == '1';
}

fn is_identifier_legal(c: u8) -> bool {
    return c == '_' || is_letter(c) || is_decimal_digit(c);
}

fn is_operator_legal(c: u8) -> bool {
    return c != '"' && c != '\'' &&
        ((c >= '!' && c <= '/') ||
            (c >= ':' && c <= '>') ||
            (c >= '[' && c <= '^') ||
            (c >= '{' && c <= '~'));
}

fn skip_whitespace(state: &var TokenizerState) -> bool {
    var skipped = false;
    while (state.peek() is ::Some |&c| && is_whitespace(c)) {
        skipped = true;
        state.next();
    }

    return skipped;
}

fn tokenize_comment(state: &var TokenizerState) -> bool {
    const start_index = state.cursor.index;
    if (state.peek() is ::Some |&first| && first == '/' && state.peek(1) is ::Some |&second|) {
        match (second) {
            '/' {
                // single line comment, go until the end of the line or end of the file
                state.next();
                state.next();

                while (state.peek() is ::Some |&c| && c != '\n') {
                    state.next();
                }

                const end_index = state.cursor.index;
                const token_view = &state.cursor.src[start_index..end_index];

                state.push(Token { .kind = ::comment, .view = &token_view });

                return true;
            }
            '*' {
                // multi-line comment, go until matching closing tag
                state.next();
                state.next();

                var depth = 1;
                while (depth > 0 && state.peek() is ::Some |&first|) {
                    if (state.peek(1) is ::Some |&second|) {
                        if (first == '*' && second == '/') {
                            depth -= 1;
                            state.next();
                        } else if (first == '/' && second == '*') {
                            depth += 1;
                            state.next();
                        }
                    }
                    state.next();
                }

                const end_index = state.cursor.index;
                const token_view = &state.cursor.src[start_index..end_index];

                if (depth != 0) {
                    state.push(Token { .kind = ::error_invalid_comment, .view = &token_view });
                } else {
                    state.push(Token { .kind = ::comment, .view = &token_view });
                }

                return true;
            }
        }
    }

    return false;
}

fn tokenize_identifier(state: &var TokenizerState) -> bool {
    if (state.peek() is ::Some |first| && first != '_' && !is_letter(first)) {
        return false;
    }

    const start_index = state.cursor.index;
    while (state.peek() is ::Some |c| && is_identifier_legal(c)) {
        state.next();
    }

    const end_index = state.cursor.index;
    const token_view = &state.cursor.src[start_index..end_index];

    const token_kind = if (keyword_token_kind(&token_view) is ::Some |&token_kind|) token_kind else ::identifier;

    state.push(Token { .kind = token_kind, .view = &token_view });

    return true;
}

fn tokenize_operator(state: &var TokenizerState) -> bool {
    if (state.peek() is ::Some |first| && !is_operator_legal(first)) {
        return false;
    }

    const remaining = state.cursor.src.length() - state.cursor.index;

    const max_operator_length: u64 = 3;
    var len = if (max_operator_length < remaining) max_operator_length else remaining;
    while (len > 0) {
        const end_index = state.cursor.index + len;
        const candidate = &state.cursor.src[state.cursor.index..end_index];

        if (operator_token_kind(&candidate) is ::Some |&token_kind|) {
            state.push(Token { .kind = token_kind, .view = &candidate });
            state.cursor.index = end_index;
            return true;
        }

        len -= 1;
    }

    // no known operator/punctuation matched, consume one character as an error token.
    const start_index = state.cursor.index;
    state.next();
    const token_view = &state.cursor.src[start_index..state.cursor.index];
    state.push(Token { .kind = ::error_invalid_operator, .view = &token_view });

    return true;
}

fn tokenize_number_literal(state: &var TokenizerState) -> bool {
    if (state.peek() is ::Some |c| && !is_decimal_digit(c)) {
        return false;
    }

    var is_error = false;
    var is_decimal = true;
    var is_float = false;

    const start_index = state.cursor.index;

    var is_valid_digit = is_decimal_digit;

    // check for hex/binary/octal and consume leading 0x/0b/0o
    if (state.peek() is ::Some |first| && first == '0'
            && state.peek(1) is ::Some |second|) {
        if (second == 'x' || second == 'b' || second == 'o') {
            is_decimal = false;

            is_valid_digit = match (second) {
                'x' is_hex_digit;
                'b' is_binary_digit;
                'o' is_octal_digit;
                else is_decimal_digit;
            };

            state.next();
            state.next();
        }
    }

    // consume leading digits or hex/binary/octal digits
    var num_digits = 0;
    while (state.peek() is ::Some |c| && is_valid_digit(c)) {
        num_digits += 1;
        state.next();
    }

    if (num_digits == 0) {
        is_error = true;
    }

    // check for digit after the decimal point, only if leading digits are decimal
    if (is_decimal) {
        if (state.peek() is ::Some |first| && first == '.' && state.peek(1) is ::Some |second| && is_decimal_digit(second)) {
            is_float = true;
            state.next();

            while (state.peek() is ::Some |c| && is_decimal_digit(c)) {
                state.next();
            }
        }
    }

    // check for exponent form, only if leading digits are decimal
    if (is_decimal) {
        if (state.peek() is ::Some |e| && (e == 'e' || e == 'E')) {
            is_float = true;

            // consume e or E
            state.next();

            // consume + or -, if they exist
            if (state.peek() is ::Some |sign| && (sign == '+' || sign == '-')) {
                state.next();
            }

            // consume exponent digits
            var num_digits = 0;
            while (state.peek() is ::Some |digit| && is_decimal_digit(digit)) {
                num_digits += 1;
                state.next();
            }

            if (num_digits == 0) {
                is_error = true;
            }
        }
    }

    const end_index = state.cursor.index;
    const token_view = &state.cursor.src[start_index..end_index];

    if (is_error) {
        state.push(Token { .kind = ::error_invalid_number_literal, .view = &token_view });
    }
    else if (is_float) {
        state.push(Token { .kind = ::float_literal, .view = &token_view });
    } else {
        state.push(Token { .kind = ::integer_literal, .view = &token_view });
    }

    return true;
}

fn tokenize_string_or_char_literal(state: &var TokenizerState) -> bool {
    const first = if (state.peek() is ::Some |c|) c else { return false; };

    if (first != '"' && first != '\'') {
        return false;
    }

    const start_index = state.cursor.index;
    state.next();

    var valid = true;
    while (state.peek() is ::Some |c| && c != first && c != '\n') {
        state.next();
        if (c == '\\') {
            valid = valid && consume_escape(&var state);
        }
    }

    // a newline or the end of the file leaves the literal unterminated
    var terminated = false;
    if (state.peek() is ::Some |c| && c == first) {
        terminated = true;
        state.next();
    }

    const end_index = state.cursor.index;
    const token_view = &state.cursor.src[start_index..end_index];

    // single quotes must hold at least one character
    const empty_char = first == '\'' && end_index - start_index == 2;

    if (!terminated || !valid || empty_char) {
        if (first == '"') {
            state.push(Token { .kind = ::error_invalid_string_literal, .view = &token_view });
        } else {
            state.push(Token { .kind = ::error_invalid_char_literal, .view = &token_view });
        }
        return true;
    }

    if (first == '"') {
        state.push(Token { .kind = ::string_literal, .view = &token_view });
    } else {
        state.push(Token { .kind = ::char_literal, .view = &token_view });
    }

    return true;
}

// consumes the character after the backslash, true when the escape is on the spec's list
fn consume_escape(state: &var TokenizerState) -> bool {
    const c = if (state.peek() is ::Some |c|) c else { return false; };
    state.next();

    return match (c) {
        'n' true;
        'r' true;
        't' true;
        '0' true;
        '\\' true;
        '"' true;
        '\'' true;
        'x' consume_hex_digits(&var state, 2);
        'u' consume_unicode_escape(&var state);
        else false;
    };
}

fn consume_hex_digits(state: &var TokenizerState, count: u64) -> bool {
    var consumed: u64 = 0;
    while (consumed < count && state.peek() is ::Some |c| && is_hex_digit(c)) {
        state.next();
        consumed += 1;
    }

    return consumed == count;
}

fn consume_unicode_escape(state: &var TokenizerState) -> bool {
    const open = if (state.peek() is ::Some |c|) c else { return false; };
    if (open != '{') {
        return false;
    }

    state.next();

    var digits: u64 = 0;
    while (state.peek() is ::Some |c| && is_hex_digit(c)) {
        state.next();
        digits += 1;
    }

    const close = if (state.peek() is ::Some |c|) c else { return false; };
    if (close != '}') {
        return false;
    }
    state.next();

    return digits > 0;
}
