import token_kind;
import std::string;

interface Serializable {
    fn to_string() -> &[u8];
}

type Token : Serializable = struct {
    kind: TokenKind,
    str: &[u8]
};

fn to_string(self token: &Token) -> &[u8] {
    const kind_name = token.kind.name();
    const separator = " - ";
    const value = &token.str;

    var str = String::with_capacity(kind_name.length() + separator.length() + value.length());

    str.append(kind_name);
    str.append(separator);
    str.append(value);

    return str.view();
}

