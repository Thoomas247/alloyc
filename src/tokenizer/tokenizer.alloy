import std::string;
import std::io as io;

import token_kind;
import token;
import source_cursor;

type TokenizerState = struct {
    cursor: SourceCursor,
    tokens: Vector<Token>
};

pub fn tokenize(src: &[u8]) -> Vector<Token> {
    var state = TokenizerState {
        .cursor = SourceCursor {
            .src = &src,
            .index = 0
        },
        .tokens = Vector::empty()
    };

    while (state.cursor.has_next()) {

        if (skip_whitespace(&state)
                || tokenize_comment(&state)
                || tokenize_identifier(&state)
                || tokenize_operator(&state)) {
            continue;
        }

        const start_index = state.cursor.index;
        state.cursor.next();
        const token_view = state.cursor.src[start_index..state.cursor.index];
        state.tokens.push(Token { .kind = ::error_invalid_operator, .view = &token_view });
    }

    state.tokens.push(Token { .kind = ::end_of_file, .view = "" });

    return state.tokens;
}

pub fn debug_print(self tokens: &Vector<Token>) {
    for (tokens) |&t| {
        io::print_line(&t.to_string());
    }
}

fn is_whitespace(c: u8) -> bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

fn is_letter(c: u8) -> bool {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
}

fn is_digit(c: u8) -> bool {
    return (c >= '0' && c <= '9');
}

fn is_identifier_legal(c: u8) -> bool {
    return c == '_' || is_letter(c) || is_digit(c);
}

fn is_operator_legal(c: u8) -> bool {
    return (c >= '!' && c <= '/') ||
        (c >= ':' && c <= '>') ||
        (c >= '[' && c <= '^') ||
        (c >= '{' && c <= '~');
}

fn skip_whitespace(state: &var TokenizerState) -> bool {
    var skipped = false;
    while (state.cursor.peek() is ::Some |&c| && is_whitespace(c)) {
        skipped = true;
        state.cursor.next();
    }

    return skipped;
}

fn tokenize_comment(state: &var TokenizerState) -> bool {
    if (state.cursor.peek() is ::Some |&first| && first == '/' && state.cursor.peek(1) is ::Some |&second|) {
        match (second) {
            '/' {
                // single line comment, go until the end of the line
                state.cursor.next();
                state.cursor.next();

                while (state.cursor.peek() is ::Some |&c| && c != '\n') {
                    state.cursor.next();
                }

                state.tokens.push(Token { .kind = ::comment, .view = &token_view });

                return true;
            }
            '*' {
                // multi-line comment, go until matching closing tag
                state.cursor.next();
                state.cursor.next();

                var depth = 1;
                while (depth > 0 && state.cursor.peek() is ::Some |&first|) {
                    if (state.cursor.peek(1) is ::Some |&second|) {
                        if (first == '*' && second == '/') {
                            depth -= 1;
                            state.cursor.next();
                        } else if (first == '/' && second == '*') {
                            depth += 1;
                            state.cursor.next();
                        }
                    }
                    state.cursor.next();
                }

                return true;
            }
        }
    }

    return false;
}

fn tokenize_identifier(state: &var TokenizerState) -> bool {
    if (state.cursor.peek() is ::Some |first| && first != '_' && !is_letter(first)) {
        return false;
    }

    const start_index = state.cursor.index;
    while (state.cursor.peek() is ::Some |c| && is_identifier_legal(c)) {
        state.cursor.next();
    }

    const end_index = state.cursor.index;
    const token_view = state.cursor.src[start_index..end_index];

    const token_kind = if (keyword_token_kind(&token_view) is ::Some |&token_kind|) token_kind else ::identifier;

    state.tokens.push(Token { .kind = token_kind, .view = &token_view });

    return true;
}

fn tokenize_operator(state: &var TokenizerState) -> bool {
    if (state.cursor.peek() is ::Some |first| && !is_operator_legal(first)) {
        return false;
    }

    const remaining = state.cursor.src.length() - state.cursor.index;

    const max_operator_length: u64 = 3;
    var len = if (max_operator_length < remaining) max_operator_length else remaining;
    while (len > 0) {
        const end_index = state.cursor.index + len;
        const candidate = state.cursor.src[state.cursor.index..end_index];

        if (operator_token_kind(&candidate) is ::Some |&token_kind|) {
            state.tokens.push(Token { .kind = token_kind, .view = &candidate });
            state.cursor.index = end_index;
            return true;
        }

        len -= 1;
    }

    // No known operator/punctuation matched; consume one character as an error token.
    const start_index = state.cursor.index;
    state.cursor.next();
    const token_view = state.cursor.src[start_index..state.cursor.index];
    state.tokens.push(Token { .kind = ::error_invalid_operator, .view = &token_view });

    return true;
}
