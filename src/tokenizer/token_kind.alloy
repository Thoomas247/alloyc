import std::string;
import std::vector;
import std::macros;

type OperatorEntry = struct {
    name: &[u8],
    op: &[u8]
};

macro make_op_entry(name: &[u8], op: &[u8]) -> OperatorEntry {
    return OperatorEntry { .name = &name, .op = &op };
}

macro error_tokens() -> &[&[u8]] {
    return [
        "error_invalid_character",
        "error_invalid_operator",
        "error_invalid_comment",
        "error_invalid_number_literal",
        "error_invalid_string_literal",
        "error_invalid_char_literal"
    ];
}

macro core_tokens() -> &[&[u8]] {
    return [
        "end_of_file",
        "comment",
        "identifier",
        "integer_literal", "float_literal", "string_literal", "char_literal"
    ];
}

// List of all keywords in the language.
macro keywords() -> &[&[u8]] {
    return [
        "import",
        "macro", "extern", "fn",
        "type", "enum", "struct",
        "const", "var",
        "if", "else", "while", "for", "match",
        "break", "continue", "yield", "return",
        "new", "move",
        "self",
        "pub", "exp",
        "true", "false",
        "interface",
        "as", "is", "to",
        "panic"
    ];
}

// List of operator names to operator symbols.
macro operators() -> &[OperatorEntry] {
    return [
        #make_op_entry("plus", "+"),
        #make_op_entry("minus", "-"),
        #make_op_entry("asterisk", "*"),
        #make_op_entry("slash", "/"),
        #make_op_entry("percent", "%"),

        #make_op_entry("plus_equal", "+="),
        #make_op_entry("minus_equal", "-="),
        #make_op_entry("asterisk_equal", "*="),
        #make_op_entry("slash_equal", "/="),
        #make_op_entry("percent_equal", "%="),
        #make_op_entry("shift_left_equal", "<<="),
        #make_op_entry("shift_right_equal", ">>="),
        #make_op_entry("ampersand_equal", "&="),
        #make_op_entry("pipe_equal", "|="),
        #make_op_entry("caret_equal", "^="),

        #make_op_entry("equal_equal", "=="),
        #make_op_entry("bang_equal", "!="),
        #make_op_entry("angle_left", "<"),
        #make_op_entry("angle_left_equal", "<="),
        #make_op_entry("angle_right", ">"),
        #make_op_entry("angle_right_equal", ">="),
        #make_op_entry("ampersand_ampersand", "&&"),
        #make_op_entry("pipe_pipe", "||"),
        #make_op_entry("bang", "!"),

        #make_op_entry("ampersand", "&"),
        #make_op_entry("pipe", "|"),
        #make_op_entry("caret", "^"),
        #make_op_entry("tilde", "~"),
        #make_op_entry("shift_left", "<<"),
        #make_op_entry("shift_right", ">>"),

        #make_op_entry("equal", "="),

        #make_op_entry("arrow", "->"),

        #make_op_entry("colon_colon", "::"),

        #make_op_entry("dot", "."),

        #make_op_entry("dot_dot", ".."),

        #make_op_entry("ellipsis", "..."),

        #make_op_entry("colon", ":"),

        #make_op_entry("comma", ","),
        #make_op_entry("semicolon", ";"),

        #make_op_entry("parenthesis_left", "("),
        #make_op_entry("parenthesis_right", ")"),
        #make_op_entry("brace_left", "{"),
        #make_op_entry("brace_right", "}"),
        #make_op_entry("bracket_left", "["),
        #make_op_entry("bracket_right", "]"),

        #make_op_entry("hash", "#")
    ];
}

macro with_prefix(prefix: &[u8], word: &[u8]) -> String {
    var name = String::from(&prefix);
    name.append(&word);
    return name;
}

macro token_kind_enum() -> #Type {
    var t = #enum_type();

    for (#error_tokens()) |&et| {
        t.add_member(et, #void);
    }

    for (#core_tokens()) |&ct| {
        t.add_member(ct, #void);
    }

    for (#keywords()) |&kw| {
        t.add_member(#with_prefix("kw_", &kw).view(), #void);
    }

    for (#operators()) |&op| {
        t.add_member(#with_prefix("op_", &op.name).view(), #void);
    }

    return t;
}

pub type TokenKind = #token_kind_enum();

type TokenDescriptor = struct {
    token: &[u8],
    kind: TokenKind
};

macro token_descriptors() -> &[TokenDescriptor] {
    var token_kind_index: u8 = 0;
    var descriptors = Vector::empty<TokenDescriptor>();

    for (#error_tokens()) |&et| {
        descriptors.push(TokenDescriptor { .token = "", .kind = token_kind_index as TokenKind });
        token_kind_index += 1;
    }

    for (#core_tokens()) {
        descriptors.push(TokenDescriptor { .token = "", .kind = token_kind_index as TokenKind });
        token_kind_index += 1;
    }

    for (#keywords()) |&kw| {
        descriptors.push(TokenDescriptor { .token = &kw, .kind = token_kind_index as TokenKind });
        token_kind_index += 1;
    }

    for (#operators()) |&op| {
        descriptors.push(TokenDescriptor { .token = &op.op, .kind = token_kind_index as TokenKind });
        token_kind_index += 1;
    }

    return &descriptors.view();
}

pub fn keyword_token_kind(kw: &[u8]) -> Option<TokenKind> {
    const token_descs = #token_descriptors();
    const start_index = #error_tokens().length() + #core_tokens().length();
    const end_index = start_index + #keywords().length();
    const kw_token_descs = #token_descs[start_index..end_index];

    for (kw_token_descs) |&desc| {
        if (text_equals(&desc.token, &kw)) {
            return ::Some(desc.kind);
        }
    }

    return ::None;
}

pub fn operator_token_kind(op: &[u8]) -> Option<TokenKind> {
    const token_descs = #token_descriptors();
    const start_index = #error_tokens().length() + #core_tokens().length() + #keywords().length();
    const end_index = start_index + #operators().length();
    const op_token_descs = #token_descs[start_index..end_index];

    for (op_token_descs) |&desc| {
        if (text_equals(&desc.token, &op)) {
            return ::Some(desc.kind);
        }
    }

    return ::None;
}

pub fn name(self token_kind: &TokenKind) -> &[u8] {
    return (#TokenKind.member_names())[token_kind to u8];
}

pub fn is_error(self token_kind: &TokenKind) -> bool {
    return (token_kind to u8) < #error_tokens().length();
}
