import token_kind;
import source::span;

pub type Token = struct {
    kind: TokenKind,
    span: Span
};

pub fn to_string(self token: &Token, src: &[u8]) -> String {
    const kind_name = &token.kind.name();
    const separator = " - ";
    const value = &src[token.span.start..token.span.end];

    var str = String::with_capacity(kind_name.length() + separator.length() + value.length());

    str.append(&kind_name);
    str.append(&separator);
    str.append(&value);

    return str;
}
