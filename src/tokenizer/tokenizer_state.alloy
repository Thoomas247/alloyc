import std::option;
import std::vector;

import token;
import source_cursor;
import source::span;
import diagnostics::diagnostics;

pub type TokenizerState = struct {
    cursor: SourceCursor,
    tokens: Vector<Token>,
    diagnostics: &var Diagnostics
};

// Returns the current character without moving the cursor.
pub fn peek(self state: &TokenizerState) -> Option<u8> {
    return state.cursor.peek();
}

// Returns the character `offset` positions ahead. 0 for the current character.
pub fn peek(self state: &TokenizerState, offset: u64) -> Option<u8> {
    return state.cursor.peek(offset);
}

// Returns true if there are more characters to read, false otherwise.
pub fn has_next(self state: &TokenizerState) -> bool {
    return state.cursor.has_next();
}

// Returns the current character and moves the cursor forward, or ::None if past the end.
pub fn next(self state: &var TokenizerState) -> Option<u8> {
    return state.cursor.next();
}

// Appends a token to the tokenizer's output.
pub fn push(self state: &var TokenizerState, token: Token) {
    state.tokens.push(token);
}

// Records a lexical error at the given span.
pub fn error(self state: &var TokenizerState, span: Span, message: &[u8]) {
    state.diagnostics.error(::Lexical({ .span = span, .message = message }));
}
