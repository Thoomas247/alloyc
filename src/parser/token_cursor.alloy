import std::option;

import tokenizer::token;

pub type TokenCursor = struct {
    tokens: &[Token],
    index: u64
};

pub fn TokenCursor::create(tokens: &[Token]) -> TokenCursor {
    return TokenCursor {
        .tokens = &tokens,
        .index = skip_errors(&tokens, 0)
    };
}

fn skip_errors(tokens: &[Token], from: u64) -> u64 {
    var index = from;
    while (index < tokens.length() && tokens[index].kind.is_error()) {
        index += 1;
    }

    return index;
}

// Returns the current token and moves the cursor forward, or ::None if past the end.
pub fn next(self cursor: &var TokenCursor) -> Option<&Token> {
    if (cursor.index >= cursor.tokens.length()) {
        return ::None;
    }

    const returned_index = cursor.index;
    cursor.index = skip_errors(&cursor.tokens, cursor.index + 1);
    return ::Some(&cursor.tokens[returned_index]);
}

// Returns true if there are more tokens to read, false otherwise.
pub fn has_next(self cursor: &TokenCursor) -> bool {
    return cursor.index < cursor.tokens.length();
}

// Returns the current token without moving the cursor.
pub fn peek(self cursor: &TokenCursor) -> Option<&Token> {
    return cursor.peek(0);
}

// Returns the token `offset` positions ahead, counting only non-error
// tokens. Set offset to 0 for current token.
pub fn peek(self cursor: &TokenCursor, offset: u64) -> Option<&Token> {
    var index = cursor.index;
    var remaining = offset;

    while (remaining > 0 && index < cursor.tokens.length()) {
        index = skip_errors(&cursor.tokens, index + 1);
        remaining -= 1;
    }

    if (index >= cursor.tokens.length()) {
        return ::None;
    }

    return ::Some(&cursor.tokens[index]);
}
