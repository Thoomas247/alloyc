    panic;
}

// primary_expr = literal
//              | identifier_expr
//              | implied_variant
//              | named_struct_init
//              | anon_struct_init
//              | "(" expression ")"
//              | array_fill
//              | array_range
//              | array_literal
//              | if_expr
//              | for_expr
//              | while_expr
//              | match_expr
//              | lambda_expr
//              | comptime_expr ;
fn parse_primary_expr(self state: &var ParserState) -> PrimaryExpr {
    panic;
}

// identifier_expr = identifier { "::" identifier } ;
fn parse_identifier_expr(self state: &var ParserState) -> IdentifierExpr {
    panic;
}

// implied_variant = "::" identifier ;
