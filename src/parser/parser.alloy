import std::option;
import std::vector;

import tokenizer::token;
import tokenizer::token_kind;
import token_cursor;
import ast;
import node_allocator;
import parser_state;
import source::span;
import diagnostics::diagnostics;

pub fn parse(tokens: &Vector<Token>, src: &[u8], diagnostics: &var Diagnostics, allocator: &var NodeAllocator) -> &Module {
    var state = ParserState {
        .cursor = TokenCursor::create(&tokens.view()),
        .alloc = &var allocator,
        .diagnostics = &var diagnostics,
        .src = &src,
        .contexts = Vector::empty(),
        .is_std_lib = false, // TODO: Set real value.
        .split_head = Token { .kind = ::end_of_file, .span = Span::empty(0) },
        .split_tail = Token { .kind = ::end_of_file, .span = Span::empty(0) },
        .has_split = false
    };

    return &state.parse_module();
}

macro definition_sync() -> &[TokenKind] {
    return [
        TokenKind::op_semicolon,
        TokenKind::kw_fn,
        TokenKind::kw_type,
        TokenKind::kw_pub,
        TokenKind::kw_exp,
        TokenKind::kw_macro,
        TokenKind::kw_interface,
        TokenKind::kw_extern
    ];
}

macro import_sync() -> &[TokenKind] {
    var sync = Vector::empty<TokenKind>();

    for (#definition_sync()) |def_sync| {
        sync.push(def_sync);
    }

    sync.push(TokenKind::kw_import);

    return &sync.view();
}

// "<" type_param { "," type_param } ">"
fn parse_type_param_list(self state: &var ParserState, dst: &var Vector<TypeParam>) -> bool {
    const open = state.current_span();
    state.assert(::op_angle_left);

    dst.push(state.parse_type_param());
    while (state.eat(::op_comma)) {
        dst.push(state.parse_type_param());
    }

    if (state.expect_closing(::op_angle_right, open) is ::None) {
        return false;
    }

    return true;
}

// "<" type { "," type } ">"
fn parse_type_list(self state: &var ParserState, dst: &var Vector<Type>) -> bool {
    const open = state.current_span();
    state.assert(::op_angle_left);

    dst.push(state.parse_type());
    while (state.eat(::op_comma)) {
        dst.push(state.parse_type());
    }

    if (state.expect_closing(::op_angle_right, open) is ::None) {
        return false;
    }

    return true;
}

// identifier { "::" identifier }
fn parse_path(self state: &var ParserState, dst: &var Vector<Ident>) -> bool {
    var ok = true;

    if (state.expect_ident() is ::Some |id|) {
        dst.push(id);
    } else {
        ok = false;
    }

    while (ok && state.eat(::op_colon_colon)) {
        if (state.expect_ident() is ::Some |id|) {
            dst.push(id);
        } else {
            ok = false;
        }
    }

    return ok;
}

// module = { import_decl } { definition } EOF
fn parse_module(self state: &var ParserState) -> &Module {
    const start = state.enter(::Module);

    var imports = Vector::empty<ImportDecl>();
    while (state.at(::kw_import)) {
        imports.push(state.parse_import_decl());
    }

    var definitions = Vector::empty<Definition>();
    while (!state.at(::end_of_file)) {
        const before = state.cursor.index;
        definitions.push(state.parse_definition());
        if (state.cursor.index == before) {
            state.next();
        }
    }

    return &state.alloc(Module {
            .span = state.leave(start),
            .imports = &state.alloc_array(&imports.view()),
            .definitions = &state.alloc_array(&definitions.view())
        });
}

// import_decl = "import" identifier { "::" identifier } [ "as" identifier ] ";"
fn parse_import_decl(self state: &var ParserState) -> ImportDecl {
    const start = state.enter(::ImportDecl);
    var ok = true;

    state.assert(::kw_import);

    var path = Vector::empty<Ident>();
    if (!state.parse_path(&var path)) {
        ok = false;
    }

    var alias: Option<Ident> = ::None;
    if (ok && state.eat(::kw_as)) {
        if (state.expect_ident() is ::Some |id|) {
            alias = ::Some(id);
        } else {
            ok = false;
        }
    }

    if (ok && state.expect(::op_semicolon) is ::None) {
        ok = false;
    }

    if (!ok) {
        state.recover(#import_sync(), ::op_semicolon);
    }

    return ImportDecl {
        .span = state.leave(start),
        .path = &state.alloc_array(&path.view()),
        .alias = alias
    };
}

// definition = [ "pub" | "exp" ] ( type_def | fn_def | extern_def | interface_def | macro_def ) ;
fn parse_definition(self state: &var ParserState) -> Definition {
    const start = state.current_span().start;

    const visibility = if (state.eat(::kw_exp)) Visibility::Exp
        else if (state.eat(::kw_pub)) Visibility::Pub
        else Visibility::Private;

    const kind: DefinitionKind = match (state.current_kind()) {
        ::kw_type DefinitionKind::TypeDef(&state.alloc(state.parse_type_def()));
        ::kw_fn DefinitionKind::FnDef(&state.alloc(state.parse_fn_def()));
        ::kw_extern DefinitionKind::ExternDef(&state.alloc(state.parse_extern_def()));
        ::kw_interface DefinitionKind::InterfaceDef(&state.alloc(state.parse_interface_def()));
        ::kw_macro DefinitionKind::MacroDef(&state.alloc(state.parse_macro_def()));
        else {
            state.expected(::Definition);

            state.next();
            state.recover(#definition_sync(), ::op_semicolon);

            yield DefinitionKind::Error(&state.error_node(state.span_from(start)));
        }
    };

    return Definition {
        .span = state.span_from(start),
        .visibility = visibility,
        .kind = kind
    };
}

// type_def = "type" identifier [ "<" type_param { "," type_param } ">" ] [ ":" interface_marker { "," interface_marker } ] "=" type terminator ;
fn parse_type_def(self state: &var ParserState) -> TypeDef {
    const start = state.enter(::TypeDef);
    var ok = true;

    state.assert(::kw_type);

    const name = if (state.expect_ident() is ::Some |id|) id else {
        ok = false;
        yield state.missing_ident();
    };

    var type_params = Vector::empty<TypeParam>();
    if (ok && state.at(::op_angle_left)) {
        ok = state.parse_type_param_list(&var type_params);
    }

    var markers = Vector::empty<InterfaceMarker>();
    if (ok && state.eat(::op_colon)) {
        markers.push(state.parse_interface_marker());

        while (state.eat(::op_comma)) {
            markers.push(state.parse_interface_marker());
        }
    }

    if (ok && state.expect(::op_equal) is ::None) {
        ok = false;
    }

    const value = if (ok) state.parse_type() else state.missing_type();

    if (ok && state.expect(::op_semicolon) is ::None) {
        ok = false;
    }

    if (!ok) {
        state.recover(#definition_sync(), ::op_semicolon);
    }

    return TypeDef {
        .span = state.leave(start),
        .name = name,
        .type_params = &state.alloc_array(&type_params.view()),
        .markers = &state.alloc_array(&markers.view()),
        .value = &state.alloc(value)
    };
}

// interface_def = "interface" identifier [ "<" type_param { "," type_param } ">" ] "{" { interface_fn } "}" ;
fn parse_interface_def(self state: &var ParserState) -> InterfaceDef {
    const start = state.enter(::InterfaceDef);
    var ok = true;

    state.assert(::kw_interface);

    const name = if (state.expect_ident() is ::Some |id|) id else {
        ok = false;
        yield state.missing_ident();
    };

    var type_params = Vector::empty<TypeParam>();
    if (ok && state.at(::op_angle_left)) {
        ok = state.parse_type_param_list(&var type_params);
    }

    const brace = if (ok) state.expect(::op_brace_left) else ::None;
    if (brace is ::None) {
        ok = false;
    }

    var interface_fns = Vector::empty<InterfaceFn>();
    while (ok && !state.at(::op_brace_right) && !state.at(::end_of_file)) {
        const before = state.cursor.index;
        interface_fns.push(state.parse_interface_fn());
        if (state.cursor.index == before) {
            state.next();
        }
    }

    if (brace is ::Some |open|) {
        state.expect_closing(::op_brace_right, open.span);
    }

    if (!ok) {
        state.recover(#definition_sync(), ::op_semicolon);
    }

    return InterfaceDef {
        .span = state.leave(start),
        .name = name,
        .type_params = &state.alloc_array(&type_params.view()),
        .functions = &state.alloc_array(&interface_fns.view())
    };
}

// interface_fn = "fn" identifier "(" receiver { "," param } ")" [ "->" type ] terminator ;
fn parse_interface_fn(self state: &var ParserState) -> InterfaceFn {
    const start = state.enter(::InterfaceFn);
    var ok = true;

    if (state.expect(::kw_fn) is ::None) {
        ok = false;
    }

    const name = if (ok && state.expect_ident() is ::Some |id|) id else {
        ok = false;
        yield state.missing_ident();
    };

    const paren = if (ok) state.expect(::op_parenthesis_left) else ::None;
    if (paren is ::None) {
        ok = false;
    }

    const receiver = if (ok) state.parse_receiver() else state.missing_receiver();

    var params = Vector::empty<Param>();
    while (ok && state.eat(::op_comma)) {
        params.push(state.parse_param());
    }

    if (paren is ::Some |open| && state.expect_closing(::op_parenthesis_right, open.span) is ::None) {
        ok = false;
    }

    var return_type: Option<&Type> = ::None;
    if (ok && state.eat(::op_arrow)) {
        return_type = ::Some(&state.alloc(state.parse_type()));
    }

    if (ok && state.expect(::op_semicolon) is ::None) {
        ok = false;
    }

    if (!ok) {
        state.recover(&[TokenKind::op_semicolon, TokenKind::kw_fn][..], ::op_semicolon);
    }

    return InterfaceFn {
        .span = state.leave(start),
        .name = name,
        .receiver = receiver,
        .params = &state.alloc_array(&params.view()),
        .return_type = return_type
    };
}

// receiver = "self" ":" ( "&" | "&" "var" | "*" | "*" "var" ) ;
fn parse_receiver(self state: &var ParserState) -> Receiver {
    var ok = true;

    if (state.expect(::kw_self) is ::None) {
        ok = false;
    }

    if (ok && state.expect(::op_colon) is ::None) {
        ok = false;
    }

    if (ok && state.eat(::op_ampersand)) {
        if (state.eat(::kw_var)) {
            return Receiver::RefVar;
        }

        return Receiver::Ref;
    } else if (ok && state.eat(::op_asterisk)) {
        if (state.eat(::kw_var)) {
            return Receiver::PtrVar;
        }

        return Receiver::Ptr;
    } else {
        state.expected(::ReceiverKind);

        ok = false;
    }

    if (!ok) {
        state.recover(&[::op_comma, ::op_parenthesis_right][..]);
    }

    return state.missing_receiver();
}

// interface_marker = identifier { "::" identifier } [ "<" type { "," type } ">" ] ;
fn parse_interface_marker(self state: &var ParserState) -> InterfaceMarker {
    const start = state.current_span().start;
    var ok = true;

    var path = Vector::empty<Ident>();
    if (!state.parse_path(&var path)) {
        ok = false;
    }

    var types = Vector::empty<Type>();
    if (ok && state.at(::op_angle_left)) {
        ok = state.parse_type_list(&var types);
    }

    if (!ok) {
        state.recover(&[::op_comma, ::op_equal, ::op_angle_right, ::op_semicolon][..]);
    }

    return InterfaceMarker {
        .span = state.span_from(start),
        .path = &state.alloc_array(&path.view()),
        .type_args = &state.alloc_array(&types.view())
    };
}

// fn_def = "fn" [ identifier "::" ] identifier [ "<" type_param { "," type_param } ">" ] function ;
fn parse_fn_def(self state: &var ParserState) -> FnDef {
    const start = state.enter(::FnDef);
    var ok = true;

    state.assert(::kw_fn);

    const first_identifier = if (state.expect_ident() is ::Some |id|) id else {
        ok = false;
        yield state.missing_ident();
    };

    var qualifier: Option<Ident> = ::None;
    const name = if (ok && state.eat(::op_colon_colon)) {
        qualifier = ::Some(first_identifier);

        yield if (state.expect_ident() is ::Some |id|) id else {
            ok = false;
            yield state.missing_ident();
        };
    } else first_identifier;

    var type_params = Vector::empty<TypeParam>();
    if (ok && state.at(::op_angle_left)) {
        ok = state.parse_type_param_list(&var type_params);
    }

    const function = if (ok) state.parse_function() else state.missing_function();

    if (!ok) {
        state.recover(#definition_sync(), ::op_semicolon);
    }

    return FnDef {
        .span = state.leave(start),
        .qualifier = qualifier,
        .name = name,
        .type_params = &state.alloc_array(&type_params.view()),
        .function = &state.alloc(function)
    };
}

// macro_def = "macro" identifier "(" [ macro_param { "," macro_param } ] ")" "->" type
//                   ( stmt_block | terminator ) ;
fn parse_macro_def(self state: &var ParserState) -> MacroDef {
    const start = state.enter(::MacroDef);
    var ok = true;

    state.assert(::kw_macro);

    const name = if (state.expect_ident() is ::Some |id|) id else {
        ok = false;
        yield state.missing_ident();
    };

    const paren = if (ok) state.expect(::op_parenthesis_left) else ::None;
    if (paren is ::None) {
        ok = false;
    }

    var params = Vector::empty<MacroParam>();
    if (ok && !state.at(::op_parenthesis_right)) {
        params.push(state.parse_macro_param());

        while (ok && state.eat(::op_comma)) {
            params.push(state.parse_macro_param());
        }
    }

    if (paren is ::Some |open| && state.expect_closing(::op_parenthesis_right, open.span) is ::None) {
        ok = false;
    }

    if (ok && state.expect(::op_arrow) is ::None) {
        ok = false;
    }

    const return_type = if (ok) state.parse_type() else state.missing_type();

    var body: Option<&StmtBlock> = ::None;
    if (ok && (!state.is_std_lib || !state.eat(::op_semicolon))) {
        body = ::Some(&state.alloc(state.parse_stmt_block()));
    }

    if (!ok) {
        state.recover(#definition_sync(), ::op_semicolon);
    }

    return MacroDef {
        .span = state.leave(start),
        .name = name,
        .params = &state.alloc_array(&params.view()),
        .return_type = &state.alloc(return_type),
        .body = body
    };
}

// macro_param = identifier [ ":" type ] ;
fn parse_macro_param(self state: &var ParserState) -> MacroParam {
    const start = state.current_span().start;
    var ok = true;

    const name = if (state.expect_ident() is ::Some |id|) id else {
        ok = false;
        yield state.missing_ident();
    };

    var type_annotation: Option<&Type> = ::None;
    if (ok && state.eat(::op_colon)) {
        type_annotation = ::Some(&state.alloc(state.parse_type()));
    }

    if (!ok) {
        state.recover(&[TokenKind::op_comma, TokenKind::op_parenthesis_right][..]);
    }

    return MacroParam {
        .span = state.span_from(start),
        .name = name,
        .type_annotation = type_annotation
    };
}

// extern_def = "extern" identifier "(" extern_params ")" [ "->" type ] terminator ;
fn parse_extern_def(self state: &var ParserState) -> ExternDef {
    const start = state.enter(::ExternDef);
    var ok = true;

    state.assert(::kw_extern);

    const name = if (state.expect_ident() is ::Some |id|) id else {
        ok = false;
        yield state.missing_ident();
    };

    const paren = if (ok) state.expect(::op_parenthesis_left) else ::None;
    if (paren is ::None) {
        ok = false;
    }

    const params = if (ok) state.parse_extern_params() else state.missing_extern_params();

    if (paren is ::Some |open| && state.expect_closing(::op_parenthesis_right, open.span) is ::None) {
        ok = false;
    }

    var return_type: Option<&Type> = ::None;
    if (ok && state.eat(::op_arrow)) {
        return_type = ::Some(&state.alloc(state.parse_type()));
    }

    if (ok && state.expect(::op_semicolon) is ::None) {
        ok = false;
    }

    if (!ok) {
        state.recover(#definition_sync(), ::op_semicolon);
    }

    return ExternDef {
        .span = state.leave(start),
        .name = name,
        .params = params,
        .return_type = return_type
    };
}

// extern_params = /* empty */
//               | param { "," param } [ "," "..." ]
//               | "..." ;
fn parse_extern_params(self state: &var ParserState) -> ExternParams {
    if (state.at(::op_parenthesis_right)) {
        // no params
        return ExternParams::Fixed([]);
    }

    if (state.eat(::op_ellipsis)) {
        // only variadic
        return ExternParams::Variadic([]);
    }

    var is_variadic = false;
    var params = Vector::empty<Param>();

    params.push(state.parse_param());
    while (state.eat(::op_comma)) {
        if (state.eat(::op_ellipsis)) {
            is_variadic = true;
            break;
        }

        params.push(state.parse_param());
    }

    const allocated = &state.alloc_array(&params.view());

    return if (is_variadic) ExternParams::Variadic(&allocated) else ExternParams::Fixed(&allocated);
}

// type_param = identifier [ ":" interface_marker ] ;
fn parse_type_param(self state: &var ParserState) -> TypeParam {
    const start = state.current_span().start;
    var ok = true;

    const name = if (state.expect_ident() is ::Some |id|) id else {
        ok = false;
        yield state.missing_ident();
    };

    var constraint: Option<&InterfaceMarker> = ::None;
    if (ok && state.eat(::op_colon)) {
        constraint = ::Some(&state.alloc(state.parse_interface_marker()));
    }

    if (!ok) {
        state.recover(&[::op_comma, ::op_parenthesis_right, ::op_angle_right][..]);
    }

    return TypeParam {
        .span = state.span_from(start),
        .name = name,
        .constraint = constraint
    };
}

/* --- Functions --- */

// function = "(" [ param { "," param } ] ")" [ "->" type ] stmt_block ;
fn parse_function(self state: &var ParserState) -> Function {
    const start = state.enter(::Function);
    var ok = true;

    const paren = state.expect(::op_parenthesis_left);
    if (paren is ::None) {
        ok = false;
    }

    var params = Vector::empty<Param>();
    if (ok && !state.at(::op_parenthesis_right)) {
        params.push(state.parse_param());

        while (ok && state.eat(::op_comma)) {
            params.push(state.parse_param());
        }
    }

    if (paren is ::Some |open| && state.expect_closing(::op_parenthesis_right, open.span) is ::None) {
        ok = false;
    }

    var return_type: Option<&Type> = ::None;
    if (ok && state.eat(::op_arrow)) {
        return_type = ::Some(&state.alloc(state.parse_type()));
    }

    const body = if (ok) state.parse_stmt_block() else state.missing_stmt_block();

    if (!ok) {
        state.recover(#definition_sync());
    }

    return Function {
        .span = state.leave(start),
        .params = &state.alloc_array(&params.view()),
        .return_type = return_type,
        .body = &state.alloc(body)
    };
}

// param = [ "self" ] identifier ":" type ;
fn parse_param(self state: &var ParserState) -> Param {
    const start = state.current_span().start;
    var ok = true;

    const is_self = state.eat(::kw_self);

    const name = if (state.expect_ident() is ::Some |id|) id else {
        ok = false;
        yield state.missing_ident();
    };

    if (ok && state.expect(::op_colon) is ::None) {
        ok = false;
    }

    const type_annotation = if (ok) state.parse_type() else state.missing_type();

    if (!ok) {
        state.recover(&[TokenKind::op_comma, TokenKind::op_parenthesis_right][..]);
    }

    return Param {
        .span = state.span_from(start),
        .is_self = is_self,
        .name = name,
        .type_annotation = &state.alloc(type_annotation)
    };
}

/* --- Types --- */

// type = type_modifier ( base_type | type ) ;
fn parse_type(self state: &var ParserState) -> Type {
    const start = state.enter(::Type);

    const modifier = state.parse_type_modifier();

    // a modifier followed by another one wraps a nested type
    const base = if (state.at(::op_asterisk) || state.at(::op_ampersand))
        TypeBase::Nested(&state.alloc(state.parse_type()))
        else TypeBase::Base(state.parse_base_type());

    return Type {
        .span = state.leave(start),
        .modifier = modifier,
        .base = base
    };
}

// type_modifier = /* none */ | "*" | "*" "var" | "&" | "&" "var" ;
fn parse_type_modifier(self state: &var ParserState) -> TypeModifier {
    panic;
}

// base_type = named_type
//           | struct_type
//           | enum_type
//           | array_type
//           | fn_type
//           | "#Type"                (* comptime descriptor, §4.4 *)
//           | comptime_expr ;
fn parse_base_type(self state: &var ParserState) -> BaseType {
    panic;
}

// named_type = identifier { "::" identifier } [ "<" type { "," type } ">" ] ;
fn parse_named_type(self state: &var ParserState) -> NamedType {
    panic;
}

// struct_type = "struct" "{" [ struct_member { "," struct_member } ] "}" ;
fn parse_struct_type(self state: &var ParserState) -> StructType {
    panic;
}

// struct_member = identifier ":" type ;
fn parse_struct_member(self state: &var ParserState) -> StructMember {
    panic;
}

// enum_type = "enum" "{" [ enum_member { "," enum_member } ] "}" ;
fn parse_enum_type(self state: &var ParserState) -> EnumType {
    panic;
}

// enum_member = identifier [ ":" type ] ;
fn parse_enum_member(self state: &var ParserState) -> EnumMember {
    panic;
}

// array_type = "[" type [ ":" expression ] "]" ;  (* sizeless form only under "&" or "*" *)
fn parse_array_type(self state: &var ParserState) -> ArrayType {
    panic;
}

// fn_type = "(" [ type { "," type } ] ")" [ "->" type ] ;
fn parse_fn_type(self state: &var ParserState) -> FnType {
    panic;
}

/* --- Statements --- */

// statement = var_def
//           | stmt_block
//           | if_expr
//           | for_expr
//           | while_expr
//           | match_expr
//           | break_stmt
//           | continue_stmt
//           | yield_stmt
//           | return_stmt
//           | panic_stmt
//           | expr_stmt ;
fn parse_statement(self state: &var ParserState) -> Statement {
    panic;
}

// var_def = ( "var" | "const" ) identifier [ ":" type ] "=" expression terminator ;
fn parse_var_def(self state: &var ParserState) -> VarDef {
    panic;
}

// stmt_block = "{" { statement } "}" ;
fn parse_stmt_block(self state: &var ParserState) -> StmtBlock {
    panic;
}

// break_stmt = "break" [ expression ] terminator ;
fn parse_break_stmt(self state: &var ParserState) -> BreakStmt {
    panic;
}

// continue_stmt = "continue" terminator ;
fn parse_continue_stmt(self state: &var ParserState) -> ContinueStmt {
    panic;
}

// yield_stmt = "yield" expression terminator ;
fn parse_yield_stmt(self state: &var ParserState) -> YieldStmt {
    panic;
}

// return_stmt = "return" [ expression ] terminator ;
fn parse_return_stmt(self state: &var ParserState) -> ReturnStmt {
    panic;
}

// panic_stmt = "panic" [ expression ] terminator ;   (* the expression is a '&[u8]' message, §5.3 *)
fn parse_panic_stmt(self state: &var ParserState) -> PanicStmt {
    panic;
}

// expr_stmt = expression ( assign_op expression terminator | terminator ) ;
