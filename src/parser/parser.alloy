    panic;
}

// array_literal = "[" [ expression { "," expression } ] "]" ;
fn parse_array_literal(self state: &var ParserState) -> ArrayLiteral {
    panic;
}

// array_fill = "[" expression ":" expression "]" ;
fn parse_array_fill(self state: &var ParserState) -> ArrayFill {
    panic;
}

// array_range = "[" [ expression ] ".." expression "]" ;
fn parse_array_range(self state: &var ParserState) -> ArrayRange {
    panic;
}

// named_struct_init = identifier { "::" identifier } [ "<" type { "," type } ">" ] "{" [ member_init { "," member_init } ] "}" ;
fn parse_named_struct_init(self state: &var ParserState) -> NamedStructInit {
    panic;
}

// anon_struct_init = "{" member_init { "," member_init } "}" ;   (* at least one member *)
