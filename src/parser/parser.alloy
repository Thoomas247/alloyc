import std::option;
import std::vector;

import tokenizer::token;
import tokenizer::token_kind;
import token_cursor;
import ast;
import node_allocator;
import parser_state;
import source::span;
import diagnostics::diagnostics;

pub fn parse(tokens: &Vector<Token>, src: &[u8], diagnostics: &var Diagnostics, allocator: &var NodeAllocator) -> &Module {
    var state = ParserState {
        .cursor = TokenCursor::create(&tokens.view()),
        .alloc = &var allocator,
        .diagnostics = &var diagnostics,
        .src = &src,
        .contexts = Vector::empty()
    };

    return &state.parse_module();
}

// module = { import_decl } { definition } EOF
fn parse_module(self state: &var ParserState) -> &Module {
    const start = state.enter(::Module);

    var imports = Vector::empty<ImportDecl>();
    var definitions = Vector::empty<Definition>();

    while (state.at(::kw_import)) {
        imports.push(state.parse_import_decl());
    }

    while (!state.at(::end_of_file)) {
        const before = state.cursor.index;
        definitions.push(state.parse_definition());
        if (state.cursor.index == before) {
            // the dispatcher reported the token so only step past it
            state.next();
        }
    }

    return &state.alloc(Module {
            .span = state.leave(start),
            .imports = &state.alloc_array(&imports.view()),
            .definitions = &state.alloc_array(&definitions.view())
        });
}

// import_decl = "import" identifier { "::" identifier } [ "as" identifier ] ";"
fn parse_import_decl(self state: &var ParserState) -> ImportDecl {
    const start = state.enter(::ImportDecl);
    var ok = true;

    var path = Vector::empty<Ident>();
    var alias: Option<Ident> = ::None;

    state.assert(::kw_import);

    if (state.expect_ident() is ::Some |id|) {
        path.push(id);
    } else {
        ok = false;
    }

    while (ok && state.eat(::op_colon_colon)) {
        if (state.expect_ident() is ::Some |id|) {
            path.push(id);
        } else {
            ok = false;
        }
    }

    if (ok && state.eat(::kw_as)) {
        if (state.expect_ident() is ::Some |id|) {
            alias = ::Some(id);
        } else {
            ok = false;
        }
    }

    if (ok && state.expect(::op_semicolon) is ::None) {
        ok = false;
    }

    if (!ok) {
        const sync = &[
            TokenKind::op_semicolon,
            TokenKind::kw_import,
            TokenKind::kw_fn,
            TokenKind::kw_type,
            TokenKind::kw_pub,
            TokenKind::kw_exp,
            TokenKind::kw_macro,
            TokenKind::kw_interface,
            TokenKind::kw_extern
        ][..];
        state.recover(&sync, ::op_semicolon);
    }

    return ImportDecl {
        .span = state.leave(start),
        .path = &state.alloc_array(&path.view()),
        .alias = alias
    };
}

// definition = [ "pub" | "exp" ] ( type_def | fn_def | extern_def | interface_def | macro_def ) ;
fn parse_definition(self state: &var ParserState) -> Definition {
    const start = state.current_span().start;

    const visibility = if (state.eat(::kw_exp)) Visibility::Exp
        else if (state.eat(::kw_pub)) Visibility::Pub
        else Visibility::Private;

    const kind: DefinitionKind = match (state.current_kind()) {
        ::kw_type DefinitionKind::TypeDef(&state.alloc(state.parse_type_def()));
        ::kw_fn DefinitionKind::FnDef(&state.alloc(state.parse_fn_def()));
        ::kw_extern DefinitionKind::ExternDef(&state.alloc(state.parse_extern_def()));
        ::kw_interface DefinitionKind::InterfaceDef(&state.alloc(state.parse_interface_def()));
        ::kw_macro DefinitionKind::MacroDef(&state.alloc(state.parse_macro_def()));
        else {
            state.expected(Expectation::Definition);

            const sync = &[
                TokenKind::op_semicolon,
                TokenKind::kw_fn,
                TokenKind::kw_type,
                TokenKind::kw_pub,
                TokenKind::kw_exp,
                TokenKind::kw_macro,
                TokenKind::kw_interface,
                TokenKind::kw_extern
            ][..];

            state.next();
            state.recover(&sync, ::op_semicolon);

            yield DefinitionKind::Error(&state.error_node(Span { .start = start, .end = state.previous_end() }));
        }
    };

    return Definition {
        .span = Span { .start = start, .end = state.previous_end() },
        .visibility = visibility,
        .kind = kind
    };
}

// type_def = "type" identifier [ "<" type_param { "," type_param } ">" ] [ ":" interface_marker { "," interface_marker } ] "=" type terminator ;
fn parse_type_def(self state: &var ParserState) -> TypeDef {
    const start = state.enter(::TypeDef);
    var ok = true;

    state.assert(::kw_type);
    const name = if (state.expect_ident() is ::Some |id|) id else {
        ok = false;
        yield state.missing_ident();
    };

    var type_params = Vector::empty<TypeParam>();
    if (ok && state.eat(::op_angle_left)) {
        type_params.push(state.parse_type_param());

        while (state.eat(::op_comma)) {
            type_params.push(state.parse_type_param());
        }

        if (state.expect(::op_angle_right) is ::None) {
            ok = false;
        }
    }

    var markers = Vector::empty<InterfaceMarker>();
    if (ok && state.eat(::op_colon)) {
        markers.push(state.parse_interface_marker());

        while (state.eat(::op_comma)) {
            markers.push(state.parse_interface_marker());
        }
    }

    if (ok && state.expect(::op_equal) is ::None) {
        ok = false;
    }

    const value = if (ok) state.parse_type() else state.missing_type();

    if (ok && state.expect(::op_semicolon) is ::None) {
        ok = false;
    }

    return TypeDef {
        .span = state.leave(start),
        .name = name,
        .type_params = &state.alloc_array(&type_params.view()),
        .markers = &state.alloc_array(&markers.view()),
        .value = &state.alloc(value)
    };
}

// interface_def = "interface" identifier [ "<" type_param { "," type_param } ">" ] "{" { interface_fn } "}" ;
fn parse_interface_def(self state: &var ParserState) -> InterfaceDef {
    /*
    pub type InterfaceDef = struct {
        span: Span,
        name: Ident,
        type_params: &[TypeParam],
        functions: &[InterfaceFn]
    };
    */

    const start = state.enter(::TypeDef);
    var ok = true;

    panic;
}

