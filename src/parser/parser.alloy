    panic;
}

// for_expr = "for" "(" expression { "," expression } ")"
//            [ "|" capture { "," capture } "|" ]
//            stmt_block [ "else" stmt_block ] ;
fn parse_for_expr(self state: &var ParserState) -> ForExpr {
    panic;
}

// while_expr = "while" "(" expression ")" stmt_block [ "else" stmt_block ] ;
