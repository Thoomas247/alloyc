    panic;
}

// unary_op = "-" | "~" | "!" | "&" [ "var" ] | "new" | "move" ;
fn parse_unary_op(self state: &var ParserState) -> UnaryOp {
    panic;
}

// postfix_expr = primary_expr { postfix_suffix } ;
