import std::option;

import tokenizer::token;
import source::span;

// An identifier. Use ParserState.text() to recover the text.
pub type Ident = Span;

// Marks a span that failed to parse; the reason lives in the diagnostics sink.
pub type ErrorNode = struct {
    span: Span
};

/* --- Top level --- */

pub type Module = struct {
    span: Span,
    imports: &[ImportDecl],
    definitions: &[Definition]
};

pub type ImportDecl = struct {
    span: Span,
    path: &[Ident],
    alias: Option<Ident>
};

pub type Visibility = enum
    {
    Private,
    Pub,
    Exp
};

pub type DefinitionKind = enum {
    TypeDef: &TypeDef,
    FnDef: &FnDef,
    ExternDef: &ExternDef,
    InterfaceDef: &InterfaceDef,
    MacroDef: &MacroDef,
    Error: &ErrorNode
};

pub fn span(self kind: &DefinitionKind) -> Span {
    return match (kind) {
        DefinitionKind::TypeDef |&v| v.span;
        DefinitionKind::FnDef |&v| v.span;
        DefinitionKind::ExternDef |&v| v.span;
        DefinitionKind::InterfaceDef |&v| v.span;
        DefinitionKind::MacroDef |&v| v.span;
        DefinitionKind::Error |&v| v.span;
    };
}

pub type Definition = struct {
    span: Span,
    visibility: Visibility,
    kind: DefinitionKind
};

pub type TypeDef = struct {
    span: Span,
    name: Ident,
    type_params: &[TypeParam],
    markers: &[InterfaceMarker],
    value: &Type
};

pub type InterfaceDef = struct {
    span: Span,
    name: Ident,
    type_params: &[TypeParam],
    functions: &[InterfaceFn]
};

pub type InterfaceFn = struct {
    span: Span,
    name: Ident,
    receiver: Receiver,
    params: &[Param],
    return_type: Option<&Type>
};

pub type Receiver = enum {
    Ref,
    RefVar,
    Ptr,
    PtrVar,
    Error: &ErrorNode
};

pub type InterfaceMarker = struct {
    span: Span,
    path: &[Ident],
    type_args: &[Type]
};

pub type FnDef = struct {
    span: Span,
    qualifier: Option<Ident>,
    name: Ident,
    type_params: &[TypeParam],
    function: &Function
};

pub type MacroDef = struct {
    span: Span,
    name: Ident,
    params: &[MacroParam],
    return_type: &Type,
    body: Option<&StmtBlock>
};

pub type MacroParam = struct {
    span: Span,
    name: Ident,
    type_annotation: Option<&Type>
};

pub type ExternDef = struct {
    span: Span,
    name: Ident,
    params: ExternParams,
    return_type: Option<&Type>
};

// Whether an extern fn accepts extra C-variadic args.
pub type ExternParams = enum {
    Fixed: &[Param],
    Variadic: &[Param]
};

pub type TypeParam = struct {
    span: Span,
    name: Ident,
    constraint: Option<&InterfaceMarker>
};

/* --- Functions --- */

pub type Function = struct {
    span: Span,
    params: &[Param],
    return_type: Option<&Type>,
    body: &StmtBlock
};

pub type Param = struct {
    span: Span,
    is_self: bool,
    name: Ident,
    type_annotation: &Type
};

/* --- Types --- */

pub type TypeModifier = enum { None, Ptr, PtrVar, Ref, RefVar };

pub type TypeBase = enum {
    Base: BaseType,
    Nested: &Type,
    Error: &ErrorNode
};

pub fn span(self base: &TypeBase) -> Span {
    return match (base) {
        TypeBase::Base |&v| v.span();
        TypeBase::Nested |&v| v.span;
        TypeBase::Error |&v| v.span;
    };
}

pub type Type = struct {
    span: Span,
    modifier: TypeModifier,
    base: TypeBase
};

pub type BaseType = enum {
    NamedType: &NamedType,
    StructType: &StructType,
    EnumType: &EnumType,
    ArrayType: &ArrayType,
    FnType: &FnType,
    ComptimeTypeDescriptor: Span,
    ComptimeExpr: &ComptimeExpr
};

pub fn span(self base: &BaseType) -> Span {
    return match (base) {
        BaseType::NamedType |&v| v.span;
        BaseType::StructType |&v| v.span;
        BaseType::EnumType |&v| v.span;
        BaseType::ArrayType |&v| v.span;
        BaseType::FnType |&v| v.span;
        BaseType::ComptimeTypeDescriptor |s| s;
        BaseType::ComptimeExpr |&v| v.span;
    };
}

pub type NamedType = struct {
    span: Span,
    path: &[Ident],
    type_args: &[Type]
};

pub type StructType = struct {
    span: Span,
    members: &[StructMember]
};

pub type StructMember = struct {
    span: Span,
    name: Ident,
    type_annotation: &Type
};

pub type EnumType = struct {
    span: Span,
    members: &[EnumMember]
};

pub type EnumMember = struct {
    span: Span,
    name: Ident,
    payload_type: Option<&Type>
};

pub type ArrayType = struct {
    span: Span,
    element_type: &Type,
    size: Option<&Expression>
};

pub type FnType = struct {
    span: Span,
    param_types: &[Type],
    return_type: Option<&Type>
};

/* --- Statements --- */

pub type Statement = enum {
    VarDef: &VarDef,
    StmtBlock: &StmtBlock,
    IfExpr: &IfExpr,
    ForExpr: &ForExpr,
    WhileExpr: &WhileExpr,
    MatchExpr: &MatchExpr,
    BreakStmt: &BreakStmt,
    ContinueStmt: &ContinueStmt,
    YieldStmt: &YieldStmt,
    ReturnStmt: &ReturnStmt,
    PanicStmt: &PanicStmt,
    ExprStmt: &ExprStmt,
    Error: &ErrorNode
};

pub fn span(self stmt: &Statement) -> Span {
    return match (stmt) {
        Statement::VarDef |&v| v.span;
        Statement::StmtBlock |&v| v.span;
        Statement::IfExpr |&v| v.span;
        Statement::ForExpr |&v| v.span;
        Statement::WhileExpr |&v| v.span;
        Statement::MatchExpr |&v| v.span;
        Statement::BreakStmt |&v| v.span;
        Statement::ContinueStmt |&v| v.span;
        Statement::YieldStmt |&v| v.span;
        Statement::ReturnStmt |&v| v.span;
        Statement::PanicStmt |&v| v.span;
        Statement::ExprStmt |&v| v.span;
        Statement::Error |&v| v.span;
    };
}

pub type Mutability = enum { Var, Const };

pub type VarDef = struct {
    span: Span,
    mutability: Mutability,
    name: Ident,
    type_annotation: Option<&Type>,
    value: &Expression
};

pub type StmtBlock = struct {
    span: Span,
    statements: &[Statement]
};

pub type BreakStmt = struct {
    span: Span,
    value: Option<&Expression>
};

pub type ContinueStmt = struct {
    span: Span
};

pub type YieldStmt = struct {
    span: Span,
    value: &Expression
};

pub type ReturnStmt = struct {
    span: Span,
    value: Option<&Expression>
};

pub type PanicStmt = struct {
    span: Span,
    message: Option<&Expression>
};

pub type ExprStmt = struct {
    span: Span,
    expr: &Expression,
    assignment: Option<&Assignment>
};

pub type AssignOp = enum {
    Assign, AddAssign, SubAssign, MulAssign, DivAssign, ModAssign,
    ShlAssign, ShrAssign, AndAssign, OrAssign, XorAssign
};

pub type Assignment = struct {
    span: Span,
    op: AssignOp,
    value: &Expression
};

/* --- Expressions --- */

pub type BinaryOp = enum {
    Add, Sub, Mul, Div, Mod,
    Eq, Ne, Lt, Le, Gt, Ge,
    LogicalAnd, LogicalOr,
    BitAnd, BitOr, BitXor, Shl, Shr
};

pub type BinaryOperand = struct {
    span: Span,
    op: BinaryOp,
    rhs: &CastExpr
};

pub type Expression = struct {
    span: Span,
    first: &CastExpr,
    rest: &[BinaryOperand]
};

pub type IsTarget = enum {
    ImpliedVariant: &ImpliedVariant,
    NamedType: &NamedType
};

pub fn span(self target: &IsTarget) -> Span {
    return match (target) {
        IsTarget::ImpliedVariant |&v| v.span;
        IsTarget::NamedType |&v| v.span;
    };
}

pub type IsClause = struct {
    span: Span,
    target: IsTarget,
    capture: Option<&Capture>
};

pub type CastSuffix = enum {
    Is: &IsClause,
    As: &Type,
    To: &Type
};

pub fn span(self suffix: &CastSuffix) -> Span {
    return match (suffix) {
        CastSuffix::Is |&v| v.span;
        CastSuffix::As |&v| v.span;
        CastSuffix::To |&v| v.span;
    };
}

pub type CastExpr = struct {
    span: Span,
    operand: UnaryExpr,
    suffixes: &[CastSuffix]
};

pub type UnaryOp = enum { Neg, BitNot, Not, Ref, RefVar, New, Move };

pub type UnaryExpr = enum {
    Unary: &UnaryOperation,
    Postfix: &PostfixExpr,
    Error: &ErrorNode
};

pub fn span(self expr: &UnaryExpr) -> Span {
    return match (expr) {
        UnaryExpr::Unary |&v| v.span;
        UnaryExpr::Postfix |&v| v.span;
        UnaryExpr::Error |&v| v.span;
    };
}

pub type UnaryOperation = struct {
    span: Span,
    op: UnaryOp,
    operand: UnaryExpr
};

pub type PostfixExpr = struct {
    span: Span,
    primary: PrimaryExpr,
    suffixes: &[PostfixSuffix]
};

pub type PostfixSuffix = enum {
    Call: &CallSuffix,
    GenericCall: &GenericCallSuffix,
    Member: &MemberAccessSuffix,
    Index: &IndexSuffix,
    Subslice: &SubsliceSuffix
};

pub fn span(self suffix: &PostfixSuffix) -> Span {
    return match (suffix) {
        PostfixSuffix::Call |&v| v.span;
        PostfixSuffix::GenericCall |&v| v.span;
        PostfixSuffix::Member |&v| v.span;
        PostfixSuffix::Index |&v| v.span;
        PostfixSuffix::Subslice |&v| v.span;
    };
}

pub type CallSuffix = struct {
    span: Span,
    arguments: &[Expression]
};

pub type GenericCallSuffix = struct {
    span: Span,
    type_args: &[Type],
    arguments: &[Expression]
};

pub type MemberAccessSuffix = struct {
    span: Span,
    name: Ident
};

pub type IndexSuffix = struct {
    span: Span,
    index: &Expression
};

pub type SubsliceSuffix = struct {
    span: Span,
    start: Option<&Expression>,
    end: &Expression
};

pub type PrimaryExpr = enum {
    Literal: Literal,
    IdentifierExpr: &IdentifierExpr,
    ImpliedVariant: &ImpliedVariant,
    NamedStructInit: &NamedStructInit,
    AnonStructInit: &AnonStructInit,
    Parenthesized: &Expression,
    ArrayFill: &ArrayFill,
    ArrayRange: &ArrayRange,
    ArrayLiteral: &ArrayLiteral,
    IfExpr: &IfExpr,
    ForExpr: &ForExpr,
    WhileExpr: &WhileExpr,
    MatchExpr: &MatchExpr,
    LambdaExpr: &LambdaExpr,
    ComptimeExpr: &ComptimeExpr
};

pub fn span(self primary: &PrimaryExpr) -> Span {
    return match (primary) {
        PrimaryExpr::Literal |&v| v.span();
        PrimaryExpr::IdentifierExpr |&v| v.span;
        PrimaryExpr::ImpliedVariant |&v| v.span;
        PrimaryExpr::NamedStructInit |&v| v.span;
        PrimaryExpr::AnonStructInit |&v| v.span;
        PrimaryExpr::Parenthesized |&v| v.span;
        PrimaryExpr::ArrayFill |&v| v.span;
        PrimaryExpr::ArrayRange |&v| v.span;
        PrimaryExpr::ArrayLiteral |&v| v.span;
        PrimaryExpr::IfExpr |&v| v.span;
        PrimaryExpr::ForExpr |&v| v.span;
        PrimaryExpr::WhileExpr |&v| v.span;
        PrimaryExpr::MatchExpr |&v| v.span;
        PrimaryExpr::LambdaExpr |&v| v.span;
        PrimaryExpr::ComptimeExpr |&v| v.span;
    };
}

pub type IdentifierExpr = struct {
    span: Span,
    path: &[Ident]
};

pub type ImpliedVariant = struct {
    span: Span,
    name: Ident
};

pub type Literal = enum {
    Integer: &Token,
    Float: &Token,
    String: &Token,
    Char: &Token,
    True: &Token,
    False: &Token
};

pub fn span(self literal: &Literal) -> Span {
    return match (literal) {
        Literal::Integer |&v| v.span;
        Literal::Float |&v| v.span;
        Literal::String |&v| v.span;
        Literal::Char |&v| v.span;
        Literal::True |&v| v.span;
        Literal::False |&v| v.span;
    };
}

pub type ArrayLiteral = struct {
    span: Span,
    elements: &[Expression]
};

pub type ArrayFill = struct {
    span: Span,
    value: &Expression,
    count: &Expression
};

pub type ArrayRange = struct {
    span: Span,
    start: Option<&Expression>,
    end: &Expression
};

pub type NamedStructInit = struct {
    span: Span,
    path: &[Ident],
    type_args: &[Type],
    members: &[MemberInit]
};

pub type AnonStructInit = struct {
    span: Span,
    members: &[MemberInit]
};

pub type MemberInit = struct {
    span: Span,
    name: Ident,
    value: &Expression
};

pub type LambdaExpr = struct {
    span: Span,
    captures: &[Capture],
    function: &Function
};

pub type CaptureMode = enum { Value, Ref, RefVar, Move };

pub type Capture = struct {
    span: Span,
    mode: CaptureMode,
    name: Ident
};

pub type IfExpr = struct {
    span: Span,
    condition: &Expression,
    then_branch: IfBranch,
    else_branch: Option<IfBranch>
};

pub type IfBranch = enum {
    StmtBlock: &StmtBlock,
    Expression: &Expression
};

pub fn span(self branch: &IfBranch) -> Span {
    return match (branch) {
        IfBranch::StmtBlock |&v| v.span;
        IfBranch::Expression |&v| v.span;
    };
}

pub type ForExpr = struct {
    span: Span,
    subjects: &[Expression],
    captures: &[Capture],
    body: &StmtBlock,
    else_block: Option<&StmtBlock>
};

pub type WhileExpr = struct {
    span: Span,
    condition: &Expression,
    body: &StmtBlock,
    else_block: Option<&StmtBlock>
};

pub type MatchExpr = struct {
    span: Span,
    subject: &Expression,
    arms: &[MatchArmEntry],
    else_block: Option<&StmtBlock>
};

pub type MatchPattern = enum {
    Expression: &Expression,
    Else: Span
};

pub fn span(self pattern: &MatchPattern) -> Span {
    return match (pattern) {
        MatchPattern::Expression |&v| v.span;
        MatchPattern::Else |s| s;
    };
}

pub type MatchArmBody = enum {
    StmtBlock: &StmtBlock,
    Expression: &Expression
};

pub fn span(self body: &MatchArmBody) -> Span {
    return match (body) {
        MatchArmBody::StmtBlock |&v| v.span;
        MatchArmBody::Expression |&v| v.span;
    };
}

pub type MatchArmEntry = struct {
    span: Span,
    pattern: MatchPattern,
    capture: Option<&Capture>,
    body: MatchArmBody
};

pub type ComptimeTarget = enum {
    PostfixExpr: &PostfixExpr,
    StructType: &StructType,
    EnumType: &EnumType
};

pub fn span(self target: &ComptimeTarget) -> Span {
    return match (target) {
        ComptimeTarget::PostfixExpr |&v| v.span;
        ComptimeTarget::StructType |&v| v.span;
        ComptimeTarget::EnumType |&v| v.span;
    };
}

pub type ComptimeExpr = struct {
    span: Span,
    target: ComptimeTarget
};
