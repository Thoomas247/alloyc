import std::option;

import tokenizer::token;
import tokenizer::token_kind;
import token_cursor;
import node_allocator;
import ast;
import source::span;
import diagnostics::diagnostics;

pub type ParserState = struct {
    cursor: TokenCursor,
    alloc: &var NodeAllocator,
    diagnostics: &var Diagnostics,
    src: &[u8]
};

// Returns the current token without moving the cursor.
pub fn peek(self state: &ParserState) -> Option<&Token> {
    return state.cursor.peek();
}

// Returns the token `offset` positions ahead. 0 for the current token.
pub fn peek(self state: &ParserState, offset: u64) -> Option<&Token> {
    return state.cursor.peek(offset);
}

// Returns true if there are more tokens to read, false otherwise.
pub fn has_next(self state: &ParserState) -> bool {
    return state.cursor.has_next();
}

// Returns the current token and moves the cursor forward, or ::None if past the end.
pub fn next(self state: &var ParserState) -> Option<&Token> {
    return state.cursor.next();
}

// Arena-allocates a node; use for a single-reference field.
pub fn alloc<T>(self state: &var ParserState, value: T) -> &var T {
    return &var state.alloc.alloc(value);
}

// Arena-allocates a node list; use for an array field.
pub fn alloc_array<T>(self state: &var ParserState, items: &[T]) -> &var [T] {
    return &var state.alloc.alloc_array(&items);
}

// Returns the source text covered by a span.
pub fn text(self state: &ParserState, span: Span) -> &[u8] {
    return &state.src[span.start..span.end];
}

// An identifier is just its token's span.
pub fn ident(self state: &ParserState, token: &Token) -> Ident {
    return token.span as Ident;
}

// Records a diagnostic at the given span.
pub fn error(self state: &var ParserState, span: Span, message: &[u8]) {
    state.diagnostics.error(span, &message);
}

// The current token's span, or the 'end_of_file' token's span past the end.
pub fn current_span(self state: &ParserState) -> Span {
    if (state.peek() is ::Some |&token|) {
        return token.span;
    }

    panic "token stream exhausted without an end_of_file token";
}

// The end offset of the last token consumed by 'next()'.
pub fn previous_end(self state: &ParserState) -> u64 {
    return state.cursor.previous_end;
}

// Allocates an error marker node covering 'span'.
pub fn error_node(self state: &var ParserState, span: Span) -> &ErrorNode {
    return &state.alloc(ErrorNode { .span = span });
}

// Use to require a specific token, reports and doesn't consume on mismatch.
pub fn expect(self state: &var ParserState, kind: TokenKind, message: &[u8]) -> Option<&Token> {
    if (state.peek() is ::Some |&token| && token.kind == kind) {
        return state.next();
    }

    state.error(state.current_span(), &message);
    return ::None;
}

fn matches_any(kind: &TokenKind, stop: &[TokenKind]) -> bool {
    for (stop) |&s| {
        if (kind == s) {
            return true;
        }
    }

    return false;
}

// Skip to the next 'stop' token (bracket-depth aware).
// Caller must consume at least one token first, or this can't make progress.
pub fn synchronize(self state: &var ParserState, stop: &[TokenKind]) {
    var depth: u64 = 0;

    while (state.peek() is ::Some |&token|) {
        if (token.kind is ::end_of_file) {
            return;
        }

        if (token.kind is ::op_parenthesis_left
                || token.kind is ::op_bracket_left
                || token.kind is ::op_brace_left) {
            depth += 1;
        } else if (token.kind is ::op_parenthesis_right
                || token.kind is ::op_bracket_right
                || token.kind is ::op_brace_right) {
            if (depth == 0) {
                return;
            }
            depth -= 1;
        } else if (depth == 0 && matches_any(&token.kind, &stop)) {
            return;
        }

        state.next();
    }
}
