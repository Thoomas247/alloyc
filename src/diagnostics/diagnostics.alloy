import std::vector;
import std::string;
import std::io as io;

import source::span;

type Severity = enum {
    Error,
    Warning
};

pub type Expectation = enum {
    Token: TokenKind,
    Identifier,
    Definition
};

pub type Context = enum {
    Module,
    ImportDecl,
    TypeDef,
    InterfaceDef,
    InterfaceFn,
    FnDef
};

pub type Note = struct {
    span: Span,
    message: &[u8]
};

pub type DiagnosticInfo = enum {
    Lexical: struct {
        span: Span,
        message: &[u8]
    },
    Expected: struct {
        span: Span,
        expected: Expectation,
        found: TokenKind,
        context: Context,
        notes: &[Note],
    }
};

type Diagnostic = struct {
    severity: Severity,
    info: DiagnosticInfo
};

pub type Diagnostics = struct {
    entries: Vector<Diagnostic>,
    last_error_start: u64,
    suppressed: u64
};

pub fn Diagnostics::empty() -> Diagnostics {
    return Diagnostics {
        .entries = Vector::empty(),
        .last_error_start = 0,
        .suppressed = 0
    };
}

pub fn has_errors(self d: &Diagnostics) -> bool {
    for (d.entries) |&entry| {
        if (entry.severity is Severity::Error) {
            return true;
        }
    }

    return false;
}

pub fn count(self d: &Diagnostics) -> u64 {
    return d.entries.length();
}

pub fn error(self d: &var Diagnostics, info: &DiagnosticInfo) {
    d.entries.push(Diagnostic { .severity = Severity::Error, .info = info });
}

pub fn warning(self d: &var Diagnostics, info: &DiagnosticInfo) {
    d.entries.push(Diagnostic { .severity = Severity::Warning, .info = info });
}
