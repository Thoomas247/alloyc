// Tokenizer stress test: every lexical edge case of LANGUAGE_SPEC.md
// section 2 in one valid program.
//
// line comment holding tokens: "no string" 'x' 0xFF 0b10 0o7 1.5e-3 <<= ... :: ->

/* block comment
   /* nested /* twice */ and closed */ in declaration order,
   holding literals: "still a comment" '?' 9e-9 0xBAD
*/

extern printf(format: &[u8], ...) -> i32;

type Mode = enum { Off, On, Auto };

macro answer() -> i64 {
    return 40;
}

// every compound assignment, packed shifts, and mixed bases
fn shifty(value: i64) -> i64 {
    var result = value;
    result <<= 3;
    result >>= 1;
    result &= 0xFF;
    result |= 0b1;
    result ^= 0o17;
    result += 5;
    result -= 1;
    result *= 2;
    result /= 3;
    result %= 100;
    return result;
}

fn main() -> i32 {
    // integers in every base, hex digits in both cases
    const dec: i64 = 42;
    const hex: i64 = 0xdeadBEEF;
    const zero: i64 = 0x0;
    const bin: i64 = 0b1011;
    const oct: i64 = 0o644;

    // floats: dotted, exponent-only, exponents signed either way
    const plain = 1.5;
    const tiny = 0.25;
    const avogadro = 6.02e23;
    const nano = 1E-9;
    const thousands = 2.5E+3;
    const nine = 9e+0;

    // char literals: plain, every escape form, packed runs
    const letter = 'a';
    const newline = '\n';
    const carriage = '\r';
    const tab = '\t';
    const nul = '\0';
    const quote = '\'';
    const backslash = '\\';
    const hex_char = '\x41';
    const unicode_char = '\u{45}';
    const pair = 'ok';
    const packed = 'abcdefgh';

    // strings: empty, every escape at once, quotes inside text
    const empty = "";
    const escapes = "\n\r\t\0\\\"\'\x7F\u{1F600}";
    const quoted = "she said \"hi\" and left";

    // identifiers that flirt with keywords stay identifiers
    var iffy: i64 = 1;
    var formatted: i64 = 2;
    var match_count: i64 = 3;
    var _hidden: i64 = 4;

    // operators packed together
    var n: i64 = -1;
    const negated = -n;
    const truthy = !(n != -1) && (n <= 0 || n >= -2);
    const masked = (bin & 0b110) | (oct ^ 0o7);
    const inverted = ~dec;
    const shifted = dec << 2 >> 1;

    // digits against dots: a subslice stays integers around a range
    const digits = [1, 2, 3, 4];
    const window = &digits[1..3];

    // enum tags cross both ways through 'to'
    const on = 1 to Mode;
    var mode_value: i64 = 0;
    if (on is ::On) {
        mode_value = Mode::Auto to i64;
    }

    // a value match over an open domain carries its else
    const graded = match (letter) {
        'a' 1;
        'b' 2;
        else 0;
    };

    var total: i64 = #answer();
    total += shifty(dec);
    total += masked % 100;
    total += shifted;
    total += negated;
    total += inverted + 43;
    total += mode_value;
    total += graded;
    total += window.length() to i64;
    total += hex & 0xF;
    total += zero;
    total += (plain + tiny) to i64;
    total += nine to i64;
    total += escapes.length() to i64;
    total += quoted.length() to i64;
    total += empty.length() to i64;
    total += newline to i64;
    total += carriage to i64;
    total += tab to i64;
    total += nul to i64;
    total += quote to i64;
    total += backslash to i64;
    total += (hex_char to i64) - (unicode_char to i64);
    total += iffy + formatted + match_count + _hidden;
    if (truthy && dec == 42 && bin < oct && oct > bin) {
        total += 1;
    }
    if (avogadro > 1e20 && nano < 1.0 && thousands >= 2.5e3) {
        total += 1;
    }
    if (pair to i64 > 0 && packed to i64 > 0) {
        total += 1;
    }

    printf("total=%d letter=%c\n", total to i32, letter to i32);

    return (total % 100) to i32;
}
